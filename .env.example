# Public canonical origin.
SITE_URL=https://reacstudio.com
PUBLIC_CONTACT_EMAIL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Server only. Do not put secrets in HTML or public configuration.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_SECRET=
# PUBLIC ownership key (8-128 hex characters), not an API secret.
# Optional override of the public key generated in site.config.mjs.
# Keep it stable; publish its key file before submitting URLs.
INDEXNOW_KEY=

# Booking phase one: local only. production is intentionally blocked in code.
BOOKING_MODE=
# Administrative session password: generate locally with npm run admin:setup.
BOOKING_ADMIN_SECRET=
# Optional JSON array of {salt,hash}: scrypt, 16-byte salt and 64-byte hash in hex.
# When present, these passwords replace the secret as the login credential.
BOOKING_ADMIN_PASSWORD_HASHES=
# local (durable ignored test file) or upstash. google_test requires upstash.
BOOKING_STORAGE=
# google_test requires a dedicated test calendar, never primary, and test emails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Legacy fallback for old mock fixtures; google_test requires both explicit IDs below.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ID_MISAEL=
GOOGLE_CALENDAR_ID_TOMAS=
BOOKING_TEST_EMAILS=
# Reuses UPSTASH_REDIS_REST_URL/TOKEN and CONTACT_RATE_LIMIT_SECRET above.
